rules_version = '2';

// 권한은 화면이 아니라 여기서 막는다.
//   개발자: 아래 developerEmails()에 있는 구글 계정. 모든 권한. users 문서의 role과 상관없어서 누가 role을 바꿔도 안 빠진다.
//   펀드 담당: users/{uid}.role == 'fund'. 주문 처리, 메뉴, 운영 설정.
//   일반: 주문하기, 내 주문 보기.
service cloud.firestore {
  match /databases/{db}/documents {

    // ★ 개발자 이메일. js/config.js의 DEVELOPER_EMAILS와 똑같이 맞출 것 (소문자)
    function developerEmails() { return ['your_email@gmail.com']; }

    function signedIn() { return request.auth != null; }
    function isDev() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in developerEmails();
    }
    function userPath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function myRole() {
      return signedIn() && exists(userPath()) ? get(userPath()).data.get('role', '') : '';
    }
    function isFund() { return isDev() || myRole() == 'fund'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // 사용자 정보: 본인과 개발자만 읽는다. role 은 개발자만 바꿀 수 있다.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDev());
      allow create: if signedIn() && ((request.auth.uid == uid && !('role' in request.resource.data)) || isDev());
      allow update: if isDev() || (signedIn() && request.auth.uid == uid && !changed().hasAny(['role']));
      allow delete: if isDev();
    }

    // 로그인 기록: 본인 기록만 남길 수 있고(이메일 위조 불가), 읽기·삭제는 개발자만. 수정은 아무도 못 한다.
    match /login_logs/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '').lower()
        && request.resource.data.type in ['login', 'signup', 'session', 'logout']
        && request.resource.data.userAgent.size() <= 300;
      allow read, delete: if isDev();
      allow update: if false;
    }

    // 메뉴: 누구나 읽고, 펀드 담당과 개발자가 고친다
    match /menu/{id} {
      allow read: if true;
      allow write: if isFund();
    }

    // 주문 받기 스위치와 공지
    match /meta/settings {
      allow read: if true;
      allow write: if isFund();
    }

    // 주문 번호 카운터: 1씩만 올릴 수 있다 (개발자는 자유롭게)
    match /meta/counter {
      allow read: if signedIn();
      allow create: if isDev() || (signedIn() && request.resource.data.n == 1);
      allow update: if isDev() || (signedIn() && request.resource.data.n == resource.data.n + 1);
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFund());

      // 본인 이름으로, '접수됨' 상태로만 만들 수 있다
      allow create: if isDev() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paid == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.student is string
        && request.resource.data.student.size() <= 60
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 60
        && request.resource.data.note.size() <= 300);

      // 개발자는 무엇이든, 펀드 담당은 상태와 입금 확인만, 주문자는 '접수됨'일 때 취소만
      allow update: if isDev()
        || (isFund() && changed().hasOnly(['status', 'paid', 'updatedAt']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && changed().hasOnly(['status', 'updatedAt']));

      allow delete: if isDev();
    }

    // 개발자는 위에 없는 컬렉션까지 전부 읽고 쓸 수 있다
    match /{document=**} {
      allow read, write: if isDev();
    }
  }
}
